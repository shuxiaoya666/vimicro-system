# ========== 方式一：云端部署（推荐） ==========
# 使用连接字符串，适配 PlanetScale / TiDB Cloud / Render MySQL 等
# 格式: mysql://用户名:密码@主机:端口/数据库名
# PlanetScale 示例: mysql://xxxxxxxx:password@aws.connect.psdb.cloud/xiaowei_system?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://user:password@host:port/xiaowei_system

# ========== 方式二：本地开发 ==========
# 如果不使用 DATABASE_URL，则使用以下分离配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=xiaowei_system

# ========== JWT 配置 ==========
JWT_SECRET=xiaowei_dental_implant_system_secret_key_2025
JWT_EXPIRES_IN=7d

# ========== 服务器配置 ==========
PORT=3000
