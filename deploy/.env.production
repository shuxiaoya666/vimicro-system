# ============================================================================
# 小唯管理系统 - 生产环境配置
# 使用方法: 复制到 /var/www/xiaowei/backend/.env
# 修改其中的密码和域名信息
# ============================================================================

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Xiaowei@2025!
DB_NAME=xiaowei_system

# JWT 配置 (生产环境请修改密钥)
JWT_SECRET=xiaowei_production_secret_2026_change_me
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3000
NODE_ENV=production

# 前端地址 (CORS用)
CORS_ORIGIN=https://YOUR_DOMAIN
