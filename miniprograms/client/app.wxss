/* 小唯客户端 - 全局样式 */
page {
  background: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #2c3e50;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 青绿色主题色 */
.text-primary { color: #1abc9c; }
.bg-primary { background: #1abc9c; }
.text-blue { color: #3498db; }
.text-orange { color: #f39c12; }
.text-red { color: #e74c3c; }
.text-muted { color: #999; }
.text-success { color: #27ae60; }
.text-warning { color: #f39c12; }
.text-danger { color: #e74c3c; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.btn-primary {
  background: linear-gradient(135deg, #1abc9c, #16a085);
  color: #fff;
}
.btn-outline {
  border: 2rpx solid #1abc9c;
  color: #1abc9c;
  background: transparent;
}
.btn-warn {
  background: linear-gradient(135deg, #f39c12, #e67e22);
  color: #fff;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.tag-active { background: #e8f8f5; color: #1abc9c; }
.tag-pending { background: #fff4e6; color: #f39c12; }
.tag-inactive { background: #fee; color: #e74c3c; }

/* 统计卡片 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 16rpx;
}
.stat-card {
  flex: 1;
  min-width: 300rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1abc9c;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
}
.list-item:last-child { border-bottom: none; }
.list-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}
.list-item-arrow {
  margin-left: auto;
  color: #ccc;
  font-size: 32rpx;
}

/* 输入框 */
.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.input:focus { border-color: #1abc9c; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #ccc;
  font-size: 28rpx;
}
