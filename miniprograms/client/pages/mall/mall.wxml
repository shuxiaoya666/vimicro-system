<view class="mall-page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品名称、分类..." bindinput="onSearch" />
  </view>
  <scroll-view scroll-x class="category-bar">
    <view class="cat-item {{activeCategory === item.value ? 'active' : ''}}" wx:for="{{categories}}" wx:key="value" bindtap="selectCategory" data-value="{{item.value}}">
      {{item.label}}
    </view>
  </scroll-view>
  <view class="product-grid">
    <view class="product-card" wx:for="{{filteredProducts}}" wx:key="id" bindtap="goProductDetail" data-id="{{item.id}}">
      <view class="product-icon">{{item.icon || '📦'}}</view>
      <view class="product-name">{{item.name}}</view>
      <view class="product-desc">{{item.desc}}</view>
      <view class="product-footer">
        <text class="product-price">¥{{item.price}}</text>
        <text class="product-stock" wx:if="{{item.stock > 0}}">库存{{item.stock}}</text>
        <text class="product-stock out" wx:else>缺货</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{filteredProducts.length === 0}}">暂无商品</view>
</view>
