.profile-page { padding: 24rpx; }
.profile-header {
  background: linear-gradient(135deg, #1abc9c, #16a085);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}
.profile-avatar {
  width: 128rpx; height: 128rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 700;
  margin: 0 auto 16rpx;
}
.profile-name { font-size: 40rpx; font-weight: 700; }
.profile-role { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }
.profile-menu {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 40rpx; margin-right: 24rpx; }
.menu-name { flex: 1; font-size: 30rpx; }
.menu-arrow { color: #ccc; font-size: 32rpx; }
.logout-btn { width: 100%; margin-top: 32rpx; }
