.reviews-page { padding: 24rpx; padding-bottom: 120rpx; }
.review-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.review-top { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.review-stars { color: #f39c12; font-size: 28rpx; }
.review-target { font-size: 30rpx; font-weight: 500; margin-bottom: 8rpx; }
.review-content { font-size: 28rpx; color: #555; margin-bottom: 12rpx; }
.review-date { font-size: 24rpx; color: #999; }
.form-item { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 28rpx; margin-bottom: 8rpx; font-weight: 500; }
.textarea { width: 100%; min-height: 160rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; box-sizing: border-box; }
.fab { position: fixed; right: 48rpx; bottom: 48rpx; width: 112rpx; height: 112rpx; border-radius: 56rpx; background: #1abc9c; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 56rpx; box-shadow: 0 4rpx 16rpx rgba(26,188,156,0.4); z-index: 100; }
