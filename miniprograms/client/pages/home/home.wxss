.home-page { padding-bottom: 32rpx; }
.header-banner {
  background: linear-gradient(135deg, #1abc9c, #16a085);
  padding: 48rpx 32rpx 32rpx;
  color: #fff;
}
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.user-greeting { font-size: 40rpx; font-weight: 700; }
.user-role { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.user-avatar {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
}
.header-stats {
  display: flex;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx 0;
}
.header-stat {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}
.header-stat-value { font-size: 44rpx; font-weight: 700; }
.header-stat-label { font-size: 24rpx; opacity: 0.8; }

.plant-card {
  margin: -20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.plant-left { display: flex; align-items: center; gap: 24rpx; }
.plant-icon { font-size: 56rpx; }
.plant-title { font-size: 34rpx; font-weight: 600; color: #2c3e50; }
.plant-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.plant-arrow { color: #1abc9c; font-size: 40rpx; }

.section-title {
  margin: 32rpx 24rpx 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx;
}
.quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}
.quick-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}
.quick-name { font-size: 24rpx; color: #2c3e50; }

.order-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.order-item:last-child { border-bottom: none; }
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.order-no { font-size: 28rpx; font-weight: 500; }
.order-desc { font-size: 26rpx; color: #666; }
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.order-amount { font-size: 32rpx; font-weight: 600; color: #1abc9c; }
.order-date { font-size: 24rpx; color: #999; }
