.progress-page { padding: 24rpx; }
.prog-header { text-align: center; margin-bottom: 32rpx; }
.prog-title { font-size: 40rpx; font-weight: 700; color: #2c3e50; }
.prog-stat { font-size: 28rpx; color: #1abc9c; margin-top: 8rpx; }
.timeline { padding: 16rpx 0; }
.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 48rpx;
}
.timeline-dot {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  z-index: 2;
}
.timeline-dot.done { background: #1abc9c; color: #fff; }
.timeline-content { margin-left: 24rpx; flex: 1; }
.timeline-name { font-size: 30rpx; font-weight: 500; color: #2c3e50; }
.timeline-date { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.timeline-line {
  position: absolute;
  left: 31rpx;
  top: 64rpx;
  width: 2rpx;
  height: 48rpx;
  background: #e0e0e0;
}
.timeline-line.done { background: #1abc9c; }
.tip-text { font-size: 28rpx; color: #555; line-height: 1.8; padding: 8rpx 0; }
