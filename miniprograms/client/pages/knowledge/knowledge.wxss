.knowledge-page { padding-bottom: 32rpx; }
.know-banner { background: linear-gradient(135deg, #1abc9c, #16a085); padding: 48rpx 32rpx; color: #fff; text-align: center; }
.know-title { font-size: 44rpx; font-weight: 700; }
.know-subtitle { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }
.article-list { padding: 24rpx; }
.article-card { display: flex; gap: 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.article-icon { width: 96rpx; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.article-right { flex: 1; }
.article-tag { display: inline-block; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: #f8f9fa; margin-bottom: 8rpx; }
.article-title { font-size: 30rpx; font-weight: 500; margin-bottom: 8rpx; }
.article-summary { font-size: 24rpx; color: #999; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
