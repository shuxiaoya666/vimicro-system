.cards-page { padding: 24rpx; padding-bottom: 120rpx; }
.my-card {
  background: linear-gradient(135deg, #1abc9c, #16a085);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  color: #fff;
}
.card-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-no { font-size: 32rpx; font-weight: 600; }
.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}
.form-section { margin-top: 24rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 28rpx; margin-bottom: 8rpx; font-weight: 500; }
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 48rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #1abc9c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 4rpx 16rpx rgba(26,188,156,0.4);
  z-index: 100;
}
