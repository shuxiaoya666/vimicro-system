.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1abc9c 0%, #16a085 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 48rpx;
  box-sizing: border-box;
}
.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}
.logo {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 16rpx;
}
.subtitle {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 32rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  color: #fff;
  font-size: 24rpx;
}
.login-form {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
}
.form-item {
  margin-bottom: 32rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #2c3e50;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.login-btn {
  width: 100%;
  margin-top: 16rpx;
}
.login-hint {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
}
