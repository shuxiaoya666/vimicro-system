<view class="settings-page">
  <view class="settings-header">
    <view class="settings-avatar">{{userInfo.name ? userInfo.name.charAt(0) : 'U'}}</view>
    <view class="settings-info">
      <view class="settings-name">{{userInfo.name || userInfo.account || '用户'}}</view>
      <view class="settings-role">{{userInfo.role || '管理员'}} · {{portName}}</view>
    </view>
  </view>

  <view class="settings-group">
    <view class="settings-item" bindtap="goPort">
      <text class="settings-item-icon">🔄</text>
      <text class="settings-item-label">切换端口</text>
      <text class="settings-item-arrow">›</text>
    </view>
  </view>

  <view class="settings-group">
    <view class="settings-item" bindtap="about">
      <text class="settings-item-icon">ℹ️</text>
      <text class="settings-item-label">关于小唯</text>
      <text class="settings-item-arrow">›</text>
    </view>
    <view class="settings-item" bindtap="clearCache">
      <text class="settings-item-icon">🗑️</text>
      <text class="settings-item-label">清除缓存</text>
      <text class="settings-item-arrow">›</text>
    </view>
  </view>

  <view class="settings-group">
    <view class="settings-item logout" bindtap="logout">
      <text class="settings-item-icon">🚪</text>
      <text class="settings-item-label">退出登录</text>
    </view>
  </view>

  <view class="settings-version">v1.0.0 © 2025 VMicro 小唯</view>
</view>
