.list-page { display: flex; height: 100vh; }
.list-sidebar { width: 220rpx; background: #fff; border-right: 1rpx solid #eee; display: flex; flex-direction: column; flex-shrink: 0; }
.sidebar-port { padding: 24rpx 16rpx; border-bottom: 2rpx solid #f5f6fa; }
.sidebar-port-icon { font-size: 32rpx; }
.sidebar-port-name { font-size: 24rpx; font-weight: 600; display: block; }
.sidebar-switch { font-size: 20rpx; color: #999; }
.sidebar-menu { flex: 1; }
.menu-group { padding: 16rpx 0; }
.menu-group-title { font-size: 20rpx; color: #999; padding: 8rpx 24rpx; text-transform: uppercase; }
.menu-item { display: flex; align-items: center; padding: 20rpx 24rpx; font-size: 24rpx; color: #555; }
.menu-item.active { background: #e8f8f5; color: #1abc9c; font-weight: 600; border-left: 4rpx solid #1abc9c; }
.menu-icon { margin-right: 12rpx; font-size: 28rpx; }
.list-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.list-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.list-title { font-size: 32rpx; font-weight: 600; }
.list-add { padding: 8rpx 24rpx; background: #1abc9c; color: #fff; border-radius: 24rpx; font-size: 24rpx; }
.list-filters { display: flex; padding: 16rpx 24rpx; gap: 16rpx; background: #fff; }
.search-input { flex: 1; height: 64rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 20rpx; font-size: 24rpx; }
.status-picker { flex-shrink: 0; }
.picker-label { height: 64rpx; line-height: 60rpx; padding: 0 20rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; font-size: 24rpx; color: #666; }
.list-count { padding: 8rpx 24rpx; font-size: 22rpx; color: #999; }
.list-scroll { flex: 1; overflow: auto; padding: 0 24rpx 120rpx; }
.data-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.data-main { flex: 1; }
.data-title { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.data-sub { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.data-side { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
.data-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
.action-edit { font-size: 22rpx; color: #1abc9c; }
.action-del { font-size: 22rpx; color: #e74c3c; }
.form-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.form-drawer { position: fixed; bottom: 0; left: 0; right: 0; max-height: 85vh; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 101; display: flex; flex-direction: column; }
.form-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx; border-bottom: 1rpx solid #eee; }
.form-title { font-size: 32rpx; font-weight: 600; }
.form-close { font-size: 36rpx; color: #999; }
.form-body { padding: 32rpx; max-height: 60vh; }
.form-field { margin-bottom: 24rpx; }
.field-label { display: block; font-size: 26rpx; margin-bottom: 8rpx; font-weight: 500; }
.textarea { width: 100%; height: 160rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; box-sizing: border-box; }
.picker-display { height: 80rpx; line-height: 76rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 24rpx; font-size: 26rpx; }
.form-footer { display: flex; gap: 16rpx; padding: 24rpx 32rpx; border-top: 1rpx solid #eee; }
.form-footer .btn { flex: 1; }
