<view class="port-page">
  <view class="port-header">
    <view class="port-avatar">{{userInfo.name ? userInfo.name.charAt(0) : 'U'}}</view>
    <view class="port-user">
      <view class="port-username">{{userInfo.name || userInfo.account || '用户'}}</view>
      <view class="port-role">{{userInfo.role || '管理员'}}</view>
    </view>
  </view>
  <view class="port-title">选择管理端口</view>
  <view class="port-grid">
    <view class="port-card" wx:for="{{ports}}" wx:key="key" data-port="{{item.key}}" bindtap="selectPort" style="border-color: {{item.color}};">
      <view class="port-icon" style="background: {{item.color}};">{{item.icon}}</view>
      <view class="port-name">{{item.name}}</view>
      <view class="port-arrow">›</view>
    </view>
  </view>
  <view class="port-logout" bindtap="logout">退出登录</view>
</view>
