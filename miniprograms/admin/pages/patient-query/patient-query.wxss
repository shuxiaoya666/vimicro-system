.patient-page { min-height: 100vh; padding-bottom: 24rpx; }
.stat-grid { display: flex; flex-wrap: wrap; padding: 24rpx; gap: 16rpx; }
.stat-card { flex: 1; min-width: 160rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.stat-value { font-size: 40rpx; font-weight: 700; color: #1abc9c; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.filters { display: flex; padding: 0 24rpx 16rpx; gap: 16rpx; }
.search-input { flex: 1; height: 72rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 20rpx; font-size: 26rpx; }
.type-picker { flex-shrink: 0; }
.picker-label { height: 72rpx; line-height: 68rpx; padding: 0 20rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; font-size: 26rpx; color: #666; }
.patient-list { padding: 0 24rpx; }
.patient-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.patient-top { display: flex; align-items: center; margin-bottom: 16rpx; }
.patient-avatar { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #e8f8f5; color: #1abc9c; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; margin-right: 20rpx; }
.patient-info { flex: 1; }
.patient-name { font-size: 30rpx; font-weight: 600; }
.patient-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.patient-bottom { display: flex; flex-wrap: wrap; gap: 12rpx; }
.patient-tag { font-size: 22rpx; color: #666; background: #f5f6fa; padding: 4rpx 16rpx; border-radius: 8rpx; }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-drawer { position: fixed; bottom: 0; left: 0; right: 0; max-height: 80vh; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 101; display: flex; flex-direction: column; }
.modal-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx; border-bottom: 1rpx solid #eee; }
.modal-title { font-size: 32rpx; font-weight: 600; }
.modal-close { font-size: 36rpx; color: #999; }
.modal-body { padding: 24rpx 32rpx; max-height: 65vh; }
.info-section { margin-bottom: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: #1abc9c; }
.info-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f6fa; }
.info-label { width: 200rpx; font-size: 26rpx; color: #999; flex-shrink: 0; }
.info-value { flex: 1; font-size: 28rpx; color: #333; }
