<view class="patient-page">
  <view class="stat-grid">
    <view class="stat-card">
      <view class="stat-value">{{stats.total}}</view>
      <view class="stat-label">总患者</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{stats.implant}}</view>
      <view class="stat-label">种植患者</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{stats.totalImplants}}</view>
      <view class="stat-label">种植体数</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{stats.completed}}</view>
      <view class="stat-label">已完成</view>
    </view>
  </view>

  <view class="filters">
    <input class="search-input" placeholder="搜索姓名/诊断/医生/型号" value="{{keyword}}" bindinput="onSearch" />
    <picker class="type-picker" range="{{['全部', '种植', '修复', '正畸']}}" bindchange="onTypeChange">
      <view class="picker-label">{{typeFilter === 'implant' ? '种植' : typeFilter === 'repair' ? '修复' : typeFilter === 'orthodontics' ? '正畸' : '全部'}} ▾</view>
    </picker>
  </view>

  <view class="patient-list">
    <view class="patient-card" wx:for="{{filteredList}}" wx:key="id" data-id="{{item.id}}" bindtap="showDetail">
      <view class="patient-top">
        <view class="patient-avatar">{{item.name.charAt(0)}}</view>
        <view class="patient-info">
          <view class="patient-name">{{item.name}}</view>
          <view class="patient-meta">{{item.gender}} · {{item.age}}岁 · {{item.clinic}}</view>
        </view>
        <view class="tag tag-{{item.status}}">{{item.status === 'completed' ? '已完成' : '治疗中'}}</view>
      </view>
      <view class="patient-bottom">
        <text class="patient-tag">{{item.type === 'implant' ? '种植' : item.type === 'repair' ? '修复' : '正畸'}}</text>
        <text class="patient-tag" wx:if="{{item.diagnosis}}">{{item.diagnosis}}</text>
        <text class="patient-tag" wx:if="{{item.doctor}}">{{item.doctor}}医生</text>
        <text class="patient-tag" wx:if="{{item.implantModel && item.implantModel !== '-'}}">{{item.implantModel}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{filteredList.length === 0}}">暂无患者记录</view>
  </view>

  <view class="modal-mask" wx:if="{{selectedPatient}}" bindtap="closeDetail"></view>
  <view class="modal-drawer" wx:if="{{selectedPatient}}">
    <view class="modal-header">
      <text class="modal-title">患者详情</text>
      <text class="modal-close" bindtap="closeDetail">✕</text>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view class="info-section">
        <view class="section-title">基本信息</view>
        <view class="info-row">
          <text class="info-label">姓名</text>
          <text class="info-value">{{selectedPatient.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">性别</text>
          <text class="info-value">{{selectedPatient.gender}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">年龄</text>
          <text class="info-value">{{selectedPatient.age}}岁</text>
        </view>
        <view class="info-row" wx:if="{{showPhone}}">
          <text class="info-label">联系电话</text>
          <text class="info-value text-primary" data-phone="{{selectedPatient.phone}}" bindtap="callPhone">{{selectedPatient.phone}}</text>
        </view>
        <view class="info-row" wx:if="{{!showPhone}}">
          <text class="info-label">联系电话</text>
          <text class="info-value text-muted">***（无权限查看）</text>
        </view>
      </view>
      <view class="info-section">
        <view class="section-title">病历信息</view>
        <view class="info-row">
          <text class="info-label">病历号</text>
          <text class="info-value">{{selectedPatient.recordNo || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">类型</text>
          <text class="info-value">{{selectedPatient.type === 'implant' ? '种植' : selectedPatient.type === 'repair' ? '修复' : '正畸'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">诊断</text>
          <text class="info-value">{{selectedPatient.diagnosis || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">诊所</text>
          <text class="info-value">{{selectedPatient.clinic || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">医生</text>
          <text class="info-value">{{selectedPatient.doctor || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">种植体型号</text>
          <text class="info-value">{{selectedPatient.implantModel || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">手术日期</text>
          <text class="info-value">{{selectedPatient.implantDate || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">状态</text>
          <text class="info-value">{{selectedPatient.status === 'completed' ? '已完成' : '治疗中'}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
