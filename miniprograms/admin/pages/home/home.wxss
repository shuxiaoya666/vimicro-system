.home-page { min-height: 100vh; background: #f5f6fa; padding-bottom: 120rpx; }
.home-header { padding: 40rpx 24rpx 32rpx; }
.home-port-bar { display: flex; align-items: center; margin-bottom: 12rpx; }
.home-port-icon { font-size: 40rpx; margin-right: 12rpx; }
.home-port-name { font-size: 36rpx; font-weight: 700; color: #fff; flex: 1; }
.home-port-switch { font-size: 24rpx; color: rgba(255,255,255,0.85); }
.home-user { font-size: 26rpx; color: rgba(255,255,255,0.8); }
.stat-grid { display: flex; flex-wrap: wrap; padding: 24rpx; gap: 16rpx; }
.stat-card { flex: 1; min-width: 300rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.stat-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.stat-value { font-size: 44rpx; font-weight: 700; color: #1abc9c; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.section { padding: 0 24rpx; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.quick-item { width: 25%; display: flex; flex-direction: column; align-items: center; }
.quick-icon { width: 88rpx; height: 88rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; margin-bottom: 12rpx; }
.quick-name { font-size: 22rpx; color: #666; text-align: center; }
.recent-item { display: flex; align-items: flex-start; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.recent-item:last-child { border-bottom: none; }
.recent-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; margin-top: 10rpx; margin-right: 16rpx; flex-shrink: 0; }
.recent-content { flex: 1; }
.recent-title { font-size: 28rpx; color: #333; }
.recent-time { font-size: 22rpx; color: #ccc; margin-top: 4rpx; }
