/* 小唯管理端 - 全局样式 */
page {
  background: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #2c3e50;
  font-size: 28rpx;
  line-height: 1.6;
}
.text-primary { color: #1abc9c; }
.text-muted { color: #999; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.btn-primary { background: linear-gradient(135deg, #1abc9c, #16a085); color: #fff; }
.btn-outline { border: 2rpx solid #1abc9c; color: #1abc9c; background: transparent; }
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.tag-active { background: #e8f8f5; color: #1abc9c; }
.tag-pending { background: #fff4e6; color: #f39c12; }
.tag-inactive { background: #fee; color: #e74c3c; }
.tag-processing { background: #e8f0fe; color: #3498db; }
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 16rpx;
}
.stat-card {
  flex: 1;
  min-width: 300rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.stat-value { font-size: 48rpx; font-weight: 700; color: #1abc9c; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
}
.list-item:last-child { border-bottom: none; }
.list-item-icon {
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
}
.list-item-arrow { margin-left: auto; color: #ccc; font-size: 32rpx; }
.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.empty { text-align: center; padding: 80rpx 0; color: #ccc; font-size: 28rpx; }
